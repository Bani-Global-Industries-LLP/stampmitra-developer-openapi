{
  "name": "stampmitra-developer-openapi",
  "version": "0.1.0",
  "private": true,
  "description": "Public source-of-truth mirror of the StampMitra Developer API contract and shared SDK conformance assets.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "validate": "node scripts/validate-spec.mjs",
    "check": "node scripts/check-fixtures.mjs",
    "test": "npm run validate && npm run check && npm run test:mock",
    "test:mock": "node scripts/mock-smoke-test.mjs",
    "build:postman": "node scripts/build-postman.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "build:webhook-vectors": "node scripts/build-webhook-vectors.mjs",
    "sync": "node scripts/sync-from-portal.mjs",
    "mock": "node scripts/mock-server.mjs"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.4.0",
    "ajv": "^8.17.1"
  }
}
